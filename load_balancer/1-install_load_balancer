#!/usr/bin/env bash
# Installs HAProxy and load balances web-01 and web-02 with roundrobin
sudo apt-get -y update
sudo apt-get -y install haproxy
if ! grep -q "http_back" /etc/haproxy/haproxy.cfg
then
  sudo tee -a /etc/haproxy/haproxy.cfg > /dev/null << 'EOF_CFG'

frontend http_front
    bind *:80
    mode http
    default_backend http_back

backend http_back
    mode http
    balance roundrobin
    server 7359-web-01 18.171.185.250:80 check
    server 7359-web-02 18.175.44.254:80 check
EOF_CFG
fi
sudo sed -i 's/ENABLED=0/ENABLED=1/' /etc/default/haproxy
sudo service haproxy restart
