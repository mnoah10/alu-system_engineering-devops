#!/usr/bin/env bash
# Installs nginx, sets a 301 redirection and a custom 404 page
sudo apt-get -y update
sudo apt-get -y install nginx
echo "Holberton School for the win!" | sudo tee /var/www/html/index.html > /dev/null
echo "Holberton School for the win!" | sudo tee /var/www/html/index.nginx-debian.html > /dev/null
echo "Ceci n'est pas une page" | sudo tee /var/www/html/404.html > /dev/null
if ! grep -q "redirect_me" /etc/nginx/sites-available/default
then
  sudo sed -i '/server_name _;/a\\trewrite ^/redirect_me https://www.youtube.com/watch?v=QH2-TGUlwu4 permanent;' /etc/nginx/sites-available/default
fi
if ! grep -q "error_page 404" /etc/nginx/sites-available/default
then
  sudo sed -i '/server_name _;/a\\terror_page 404 /404.html;' /etc/nginx/sites-available/default
fi
sudo service nginx restart
